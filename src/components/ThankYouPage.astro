---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from './Brand.astro';
import type { Resource } from '../data/resources';

interface Props { resource: Resource; }
const { resource } = Astro.props;
---
<BaseLayout title={`${resource.title} is ready | Kavara Capital`} description={`Download ${resource.title}.`} noindex>
  <main id="main">
    <section class="thanks-hero">
      <img class="thanks-bg" src="/images/hero-kavara-links.jpg" alt="" />
      <div class="thanks-overlay"></div>
      <div class="thanks-content">
        <Brand />
        <p class="eyebrow light">Resource ready</p>
        <h1>Your guide is ready.</h1>
        <p>Thank you. You can download your copy below, and a delivery email will also be sent when the MailerLite automation is active.</p>
        <a class="download-button" href={resource.downloadUrl} target="_blank" rel="noopener noreferrer">{resource.downloadButton}<span aria-hidden="true">↓</span></a>
      </div>
    </section>
    <section class="after-download">
      <p class="eyebrow">Before you dive in</p>
      <h2>Take your time with it.</h2>
      <p>This resource is designed to support a clear, grounded understanding of Lombok property investment. It is educational information—not legal, financial, tax or investment advice.</p>
      <hr />
      <h3>What to expect next</h3>
      <ul>
        <li>Practical perspectives on Lombok property and development</li>
        <li>Real-world examples of how opportunities may be structured</li>
        <li>Updates on future resources and investment pathways</li>
      </ul>
      <p>If you would like to explore something further, reply to the delivery email or contact Kavara Capital.</p>
      <a class="text-link" href="https://kavaracapital.com/resources">Explore more investor resources →</a>
    </section>
  </main>
  <footer class="dark-footer">
    <p>KAVARA CAPITAL trading as SOLARAE CAPITAL INDONESIA</p>
    <p>Registered in Indonesia · Jalan Raya Kuta, Pujut, Lombok Tengah, NTB</p>
  </footer>
</BaseLayout>
